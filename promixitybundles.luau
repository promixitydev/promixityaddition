-- PROMIXITY BUNDLES (packed: xor + base64 + reverse)
-- returns: STAT_BUNDLES table
local K1,K2,K3,K4 = {60,101,67,114,25,218,61,189},{162,162,252,44,34,41,212,192},{166,100,25,149,246,29,34,179},{154,175,174,123,132,115,150,111}
local KEY = nil
local DATA = ""
local function unpackKey()
	local t = table.create(32)
	for i, v in ipairs(K1) do t[i] = v end
	for i, v in ipairs(K2) do t[i + 8] = v end
	for i, v in ipairs(K3) do t[i + 16] = v end
	for i, v in ipairs(K4) do t[i + 24] = v end
	KEY = t
	return t
end

local function rv(s)
	local t = table.create(#s)
	for i = #s, 1, -1 do
		t[#t + 1] = string.sub(s, i, i)
	end
	return table.concat(t)
end

local function xobf(data, key)
	local out = table.create(#data)
	for i = 1, #data do
		out[i] = string.char(bit32.bxor(data:byte(i), key[((i - 1) % #key) + 1]))
	end
	return table.concat(out)
end

local function decode()
	local ok, res = pcall(function()
		local b64 = game:GetService("HttpService"):Base64Decode(rv(DATA))
		return xobf(b64, unpackKey())
	end)
	if ok and type(res) == "string" then return res end
	return nil
end

local payload = decode()
if type(payload) == "string" then
	local loader = loadstring or load
	if loader then
		local fn = loader(payload)
		if fn then
			local ok2, tbl = pcall(fn)
			if ok2 and type(tbl) == "table" then return tbl end
		end
	end
end

return {}
